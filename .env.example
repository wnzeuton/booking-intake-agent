# Copy to .env and fill in values — never commit .env

DATABASE_URL=postgresql://booking:booking@postgres:5432/booking

# Gmail OAuth2 credentials (JSON string from Google Cloud Console)
GMAIL_CREDENTIALS={"client_id":"...","client_secret":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Email address that receives owner approval requests
OWNER_EMAIL=owner@example.com

# Gingr API key (read-only) and Playwright credentials (write)
GINGR_API_KEY=your-gingr-api-key
GINGR_API_BASE=https://app.gingrapp.com/api/v2
GINGR_USERNAME=owner@example.com
GINGR_PASSWORD=your-gingr-password

# Gemini API key — used by the booking intake agent
# Model: gemini-flash-latest (default, fast) or gemini-pro-latest (production)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-flash-latest

# Set to any non-empty value to suppress real email sends during testing
# DRY_RUN=1
